{
  "name": "sisyphus",
  "version": "1.0.0",
  "description": "Sisyphus AI Client - A modern AI assistant desktop application",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:agent && electron-vite dev",
    "build:agent": "node scripts/build-agent.mjs",
    "test:agent": "cd agent && go test -race -timeout 30s ./...",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run build:agent && electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.8",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2"
  }
}
